        Device (PILC)
        {
            Name (_HID, "QCOM0FFB")  // _HID: Hardware ID
            Alias (\_SB.PSUB, _SUB)
            Name (CHRV, Zero)
            Method (_HRV, 0, NotSerialized)  // _HRV: Hardware Revision
            {
                If ((DPBM & (One << Zero)))
                {
                    CHRV = (CHRV | (One << Zero))
                    CHRV = (CHRV | (One << One))
                    CHRV = (CHRV | (One << 0x05))
                    CHRV = (CHRV | (One << 0x06))
                }

                If ((DPBM & (One << One)))
                {
                    CHRV = (CHRV | (One << 0x05))
                    CHRV = (CHRV | (One << 0x06))
                }

                If ((DPBM & (One << 0x02)))
                {
                    CHRV = (CHRV | (One << One))
                }

                If ((DPBM & (One << 0x07)))
                {
                    CHRV = (CHRV | (One << 0x02))
                }

                If ((DPBM & (One << 0x0F)))
                {
                    CHRV = (CHRV | (One << 0x04))
                    CHRV = (CHRV | (One << One))
                }

                If ((OOBL == Zero))
                {
                    CHRV = (CHRV | (One << 0x0A))
                }

                Return (CHRV) /* \_SB_.PILC.CHRV */
            }

            Method (_STA, 0, NotSerialized)  // _STA: Status
            {
                Return (0x0F)
            }
        }

