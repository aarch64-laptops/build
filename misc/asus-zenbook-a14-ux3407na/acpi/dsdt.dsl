                    CopyObject (ToBuffer (Arg0), _T_0) /* \_SB_.TZ51._DSM._T_0 */
                    If ((_T_0 == ToUUID ("d4e1f2a3-5b6c-4d7e-8f9a-0b1c2d3e4f5a") /* Unknown UUID */))
                    {
                        While (One)
                        {
                            Name (_T_1, 0x00)  // _T_x: Emitted by ASL Compiler, x=0-9, A-Z
                            _T_1 = ToInteger (Arg2)
                            If ((_T_1 == Zero))
