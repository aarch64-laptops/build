            Method (_DSM, 4, Serialized)  // _DSM: Device-Specific Method
            {
                While (One)
                {
                    Name (_T_0, Buffer (0x01)  // _T_x: Emitted by ASL Compiler, x=0-9, A-Z
                    {
                         0x00                                             // .
                    })
                    CopyObject (ToBuffer (Arg0), _T_0) /* \_SB_.PMGK._DSM._T_0 */
                    If ((_T_0 == ToUUID ("8f17afdb-b05c-41aa-96e8-b3078b7720a2") /* Unknown UUID */))
                    {
                        While (One)
                        {
                            Name (_T_1, 0x00)  // _T_x: Emitted by ASL Compiler, x=0-9, A-Z
                            _T_1 = ToInteger (Arg2)
                            If ((_T_1 == One))
                            {
                                GADB = Arg3
                                LPID = ToInteger (GAPI)
                                LAID = ToInteger (GAAI)
                                While (One)
                                {
                                    Name (_T_2, 0x00)  // _T_x: Emitted by ASL Compiler, x=0-9, A-Z
                                    _T_2 = ToInteger (GAPI)
                                    If ((_T_2 == Zero))
                                    {
                                        CPLD = GAPL /* \_SB_.PMGK.GAPL */
                                        Break
                                    }
                                    ElseIf ((_T_2 == One))
                                    {
                                        BPLD = GAPL /* \_SB_.PMGK.GAPL */
                                        Debug = "CMBD Notify="
                                        Debug = GAAI /* \_SB_.PMGK.GAAI */
                                        Notify (\_SB.CMBD, LAID)
                                        Notify (\_SB.CMPS, Zero) // Bus Check
                                        Break
                                    }
                                    ElseIf ((_T_2 == 0x02))
                                    {
                                        UPLD = GAPL /* \_SB_.PMGK.GAPL */
                                        \_SB.UCSI.OPMR ()
                                        Notify (\_SB.UCSI, 0x80) // Status Change
                                        Break
                                    }
                                    ElseIf ((_T_2 == 0x03))
                                    {
                                        SPLD = GAPL /* \_SB_.PMGK.GAPL */
                                        Break
                                    }
                                    ElseIf ((_T_2 == 0x07))
                                    {
                                        DPLD = GAPL /* \_SB_.PMGK.GAPL */
                                        Break
                                    }
                                    ElseIf ((_T_2 == 0x0C))
                                    {
                                        OPLD = GAPL /* \_SB_.PMGK.GAPL */
                                        Break
                                    }
                                    Else
                                    {
                                        Return (Buffer (One)
                                        {
                                             0x10                                             // .
                                        })
                                        Break
                                    }

                                    Break
                                }
                            }
                            Else
                            {
                                Return (Buffer (One)
                                {
                                     0x03                                             // .
                                })
                                Break
                            }

                            Break
                        }

                        Break
                    }
                    Else
                    {
                        Return (Buffer (One)
                        {
                             0x01                                             // .
                        })
                        Break
                    }

                    Break
                }

                Return (Buffer (One)
                {
                     0x00                                             // .
                })
            }

