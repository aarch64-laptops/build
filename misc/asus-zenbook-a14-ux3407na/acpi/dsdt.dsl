                                        If ((ToInteger (DerefOf (Arg3 [Zero])) == 0x02))
                                        {
                                            TTC1 = ToInteger (DerefOf (Arg3 [0x02]))
                                            Notify (TZ62, 0x81) // Thermal Trip Point Change
                                        }

                                        Return (TTC1) /* \_SB_.TZ62.TTC1 */
                                    }
                                    ElseIf ((_T_3 == 0x04))
                                    {
                                        If ((ToInteger (DerefOf (Arg3 [Zero])) == 0x02))
                                        {
                                            TTC2 = ToInteger (DerefOf (Arg3 [0x02]))
                                            Notify (TZ62, 0x81) // Thermal Trip Point Change
                                        }

                                        Return (TTC2) /* \_SB_.TZ62.TTC2 */
                                    }
                                    Else
                                    {
                                        Debug = "Invalid TZ field type for TZ62"
                                        Return (0xFFFF)
                                    }

                                    Break
                                }
                            }
                            Else
                            {
                                Debug = "Invalid function Id for TZ62"
                                Return (0xFFFF)
                            }

                            Break
                        }
                    }
                    Else
                    {
                        Debug = "Invalid UUID for TZ62"
                        Return (0xFFFF)
                    }

                    Break
                }
            }

            Method (_DEP, 0, NotSerialized)  // _DEP: Dependencies
            {
                Return (Package (0x02)
                {
                    \_SB.MBS3, , 
                    \_SB.MBCL, 
                })
            }
        }

        Device (BTNS)
        {
            Name (_HID, "ACPI0011" /* Generic Buttons Device */)  // _HID: Hardware ID
            Alias (\_SB.PSUB, _SUB)
            Name (_UID, Zero)  // _UID: Unique ID
            Method (_CRS, 0, NotSerialized)  // _CRS: Current Resource Settings
            {
                Name (RBUF, Buffer (0x25)
                {
                    /* 0000 */  0x8C, 0x20, 0x00, 0x01, 0x00, 0x01, 0x00, 0x15,  // . ......
                    /* 0008 */  0x00, 0x02, 0x00, 0x00, 0x00, 0x00, 0x17, 0x00,  // ........
                    /* 0010 */  0x00, 0x19, 0x00, 0x23, 0x00, 0x00, 0x00, 0x07,  // ...#....
                    /* 0018 */  0x00, 0x5C, 0x5F, 0x53, 0x42, 0x2E, 0x50, 0x4D,  // .\_SB.PM
                    /* 0020 */  0x30, 0x31, 0x00, 0x79, 0x00                     // 01.y.
                })
                Return (RBUF) /* \_SB_.BTNS._CRS.RBUF */
            }

            Name (_DSD, Package (0x02)  // _DSD: Device-Specific Data
            {
                ToUUID ("fa6bd625-9ce8-470d-a2c7-b3ca36c4282e") /* Generic Buttons Device */, 
                Package (0x04)
                {
                    Package (0x05)
                    {
                        Zero, 
                        One, 
                        Zero, 
                        One, 
                        0x0D
                    }, 

                    Package (0x05)
                    {
                        One, 
                        Zero, 
                        One, 
                        One, 
                        0x81
                    }, 

                    Package (0x05)
                    {
                        One, 
                        One, 
                        One, 
                        0x0C, 
                        0xE9
                    }, 

                    Package (0x05)
                    {
                        One, 
                        0x02, 
                        One, 
                        0x0C, 
                        0xEA
                    }
                }
            })
        }

        Device (BTAT)
        {
            Name (_HID, "QCOM0FEA")  // _HID: Hardware ID
            Name (_UID, Zero)  // _UID: Unique ID
            Method (_STA, 0, NotSerialized)  // _STA: Status
            {
                Return (0x0F)
            }
        }

        Device (BTH0)
        {
            Name (_HID, "QCOM0F6B")  // _HID: Hardware ID
            Alias (\_SB.PSUB, _SUB)
            Name (_DEP, Package (0x04)  // _DEP: Dependencies
            {
                \_SB.PEP0, , 
                \_SB.PMIC, , 
                \_SB.GLNK, , 
                \_SB.UR15, 
            })
            Name (_PRW, Package (0x02)  // _PRW: Power Resources for Wake
            {
                Zero, 
                Zero
            })
            Name (_S4W, 0x02)  // _S4W: S4 Device Wake State
            Name (_S0W, 0x02)  // _S0W: S0 Device Wake State
            Method (_CRS, 0, NotSerialized)  // _CRS: Current Resource Settings
            {
                Name (PBUF, Buffer (0x45)
                {
                    /* 0000 */  0x8E, 0x1D, 0x00, 0x01, 0x00, 0x03, 0x02, 0x35,  // .......5
                    /* 0008 */  0x00, 0x01, 0x0A, 0x00, 0x00, 0xC2, 0x01, 0x00,  // ........
                    /* 0010 */  0x20, 0x00, 0x20, 0x00, 0x00, 0xC0, 0x5C, 0x5F,  //  . ...\_
                    /* 0018 */  0x53, 0x42, 0x2E, 0x55, 0x52, 0x31, 0x35, 0x00,  // SB.UR15.
                    /* 0020 */  0x8C, 0x20, 0x00, 0x01, 0x01, 0x01, 0x00, 0x00,  // . ......
                    /* 0028 */  0x00, 0x02, 0x00, 0x00, 0x00, 0x00, 0x17, 0x00,  // ........
                    /* 0030 */  0x00, 0x19, 0x00, 0x23, 0x00, 0x00, 0x00, 0x74,  // ...#...t
                    /* 0038 */  0x00, 0x5C, 0x5F, 0x53, 0x42, 0x2E, 0x47, 0x49,  // .\_SB.GI
                    /* 0040 */  0x4F, 0x30, 0x00, 0x79, 0x00                     // O0.y.
                })
                Return (PBUF) /* \_SB_.BTH0._CRS.PBUF */
            }

            Method (_DSM, 4, Serialized)  // _DSM: Device-Specific Method
            {
                If ((Arg0 == ToUUID ("07be7e46-14e3-49aa-946e-d5d21bf9beec") /* Unknown UUID */))
                {
                    While (One)
                    {
                        Name (_T_0, 0x00)  // _T_x: Emitted by ASL Compiler, x=0-9, A-Z
                        _T_0 = ToInteger (Arg2)
                        If ((_T_0 == Zero))
                        {
                            Return (0x1001)
                        }
                        ElseIf ((_T_0 == One))
                        {
                            Name (CNVM, "default")
                            Return (CNVM) /* \_SB_.BTH0._DSM.CNVM */
                        }
                        ElseIf ((_T_0 == 0x02))
                        {
                            Name (DIBF, Zero)
                            If (((\_SB.CNSF & 0x02) == 0x02))
                            {
                                DIBF = One
                            }

                            Return (DIBF) /* \_SB_.BTH0._DSM.DIBF */
                        }
                        ElseIf ((_T_0 == 0x03))
                        {
                            Name (DQHS, Zero)
                            If (((\_SB.CNSF & 0x02) == 0x02))
                            {
                                DQHS = One
                            }

                            Return (DQHS) /* \_SB_.BTH0._DSM.DQHS */
                        }
                        Else
                        {
                            Return (Zero)
                        }

                        Break
                    }
                }

                Return (Buffer (One)
                {
                     0x00                                             // .
                })
            }

            Method (_STA, 0, NotSerialized)  // _STA: Status
            {
                Return (0x0F)
            }

            Device (BSLM)
            {
                Name (_ADR, Zero)  // _ADR: Address
                Name (_CCA, Zero)  // _CCA: Cache Coherency Attribute
                Method (_STA, 0, NotSerialized)  // _STA: Status
                {
                    Return (0x0F)
                }
            }
        }

        Device (ADC1)
        {
            Name (_DEP, Package (0x02)  // _DEP: Dependencies
            {
                \_SB.SPMI, , 
                \_SB.PMIC, 
            })
            Name (_HID, "QCOM0F11")  // _HID: Hardware ID
            Name (_UID, Zero)  // _UID: Unique ID
            Alias (\_SB.PSUB, _SUB)
            Method (_CRS, 0, NotSerialized)  // _CRS: Current Resource Settings
            {
                Name (INTB, Buffer (0x4A)
                {
                    /* 0000 */  0x8C, 0x21, 0x00, 0x01, 0x00, 0x01, 0x00, 0x11,  // .!......
                    /* 0008 */  0x00, 0x01, 0x00, 0x00, 0x00, 0x00, 0x17, 0x00,  // ........
                    /* 0010 */  0x00, 0x19, 0x00, 0x23, 0x00, 0x01, 0x00, 0x28,  // ...#...(
                    /* 0018 */  0x00, 0x5C, 0x5F, 0x53, 0x42, 0x2E, 0x50, 0x4D,  // .\_SB.PM
                    /* 0020 */  0x30, 0x31, 0x00, 0x02, 0x8C, 0x21, 0x00, 0x01,  // 01...!..
                    /* 0028 */  0x00, 0x01, 0x00, 0x11, 0x00, 0x01, 0x00, 0x00,  // ........
                    /* 0030 */  0x00, 0x00, 0x17, 0x00, 0x00, 0x19, 0x00, 0x23,  // .......#
                    /* 0038 */  0x00, 0x01, 0x00, 0x29, 0x00, 0x5C, 0x5F, 0x53,  // ...).\_S
                    /* 0040 */  0x42, 0x2E, 0x50, 0x4D, 0x30, 0x31, 0x00, 0x02,  // B.PM01..
                    /* 0048 */  0x79, 0x00                                       // y.
                })
                Name (NAM, Buffer (0x0A)
                {
                    "\\_SB.SPMI"
                })
                Name (VUSR, Buffer (0x0C)
                {
                    /* 0000 */  0x8E, 0x13, 0x00, 0x01, 0x00, 0xC1, 0x02, 0x00,  // ........
                    /* 0008 */  0x90, 0x01, 0x00, 0x00                           // ....
                })
                Name (VBTM, Buffer (0x0C)
                {
                    /* 0000 */  0x8E, 0x13, 0x00, 0x01, 0x00, 0xC1, 0x02, 0x00,  // ........
                    /* 0008 */  0x91, 0x01, 0x00, 0x00                           // ....
                })
                Concatenate (VUSR, NAM, Local1)
                Concatenate (VBTM, NAM, Local2)
                Concatenate (Local1, Local2, Local3)
                Concatenate (Local3, INTB, Local0)
                Return (Local0)
            }
        }

        Name (SUPP, Zero)
        Name (CTRL, Zero)
        Method (_OSC, 4, NotSerialized)  // _OSC: Operating System Capabilities
        {
            CreateDWordField (Arg3, Zero, CDW1)
            CreateDWordField (Arg3, 0x04, CDW2)
            CreateDWordField (Arg3, 0x08, CDW3)
            If ((Arg0 == ToUUID ("23a0d13a-26ab-486c-9c5f-0ffa525a575a") /* USB4 Capabilities */))
            {
                SUPP = CDW2 /* \_SB_._OSC.CDW2 */
                CTRL = CDW3 /* \_SB_._OSC.CDW3 */
                CTRL &= 0x0F
                If ((Arg1 != One))
                {
                    CDW1 |= 0x08
                }

                If ((CDW3 != CTRL))
                {
                    CDW1 |= 0x10
                }

                CDW3 = CTRL /* \_SB_.CTRL */
                Return (Arg3)
            }
            ElseIf ((Arg0 == ToUUID ("0811b06e-4a27-44f9-8d60-3cbbc22e7b48") /* Platform-wide Capabilities */))
            {
                CTRL = CDW2 /* \_SB_._OSC.CDW2 */
                If (~(CDW1 & One))
                {
                    If ((CTRL & 0x12)){}
                    If ((CTRL & 0x00080000))
                    {
                        Debug = "OS supports battery charge limiting"
                    }
                }

                If ((Arg1 != One))
                {
                    CDW1 |= 0x08
                }

                CDW2 = CTRL /* \_SB_.CTRL */
                Return (Arg3)
            }
            Else
            {
                CDW1 |= 0x04
                Return (Arg3)
            }
        }
    }
}

