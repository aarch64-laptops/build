                                            Notify (TZ51, 0x81) // Thermal Trip Point Change
                                        }

                                        Return (TPSV) /* \_SB_.TZ51.TPSV */
                                    }
                                    ElseIf ((_T_3 == One))
                                    {
                                        If ((ToInteger (DerefOf (Arg3 [Zero])) == 0x02))
                                        {
                                            TCRT = ToInteger (DerefOf (Arg3 [0x02]))
                                            Notify (TZ51, 0x81) // Thermal Trip Point Change
                                        }

