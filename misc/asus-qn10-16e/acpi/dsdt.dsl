        Device (TSK1)
        {
            Name (_HID, "MSFT000A")  // _HID: Hardware ID
            Name (_UID, One)  // _UID: Unique ID
            Name (TEMP, Zero)
            Name (CNTR, Zero)
            Name (CNTM, 0x05)
            Name (THGF, One)
            Name (EDID, One)
            Name (ETID, One)
            Name (INTH, 0xFF)
            Name (STAT, Buffer (0x04){})
            Method (_DEP, 0, NotSerialized)  // _DEP: Dependencies
            {
                Return (Package (0x01)
                {
                    \_SB.ECGE, 
                })
            }

            Method (_STA, 0, NotSerialized)  // _STA: Status
            {
                Return (\_SB.EMPF)
            }

            Method (_TMP, 0, Serialized)  // _TMP: Temperature
            {
                While ((CNTR < CNTM))
                {
                    Debug = "TSK1 while loop"
                    Debug = CNTR /* \_SB_.TSK1.CNTR */
                    Debug = CNTM /* \_SB_.TSK1.CNTM */
                    CNTR++
                    TEMP = \_SB.ECGE._DSM (\_SB.ECGE.ECGF, Zero, 0x0A, 0x02)
                    If ((TEMP != 0x0FFF))
                    {
                        Break
                    }

                    TEMP = Zero
                    Sleep (0x32)
                }

                CNTR = Zero
                If (((TEMP & 0x8000) == 0x8000))
                {
                    TEMP = (TEMP ^ 0xFFFF)
                    TEMP = (TEMP + One)
                    TEMP = (TEMP * 0x0A)
                    TEMP = (0x0AAA - TEMP)
                }
                Else
                {
                    TEMP = (TEMP + 0x0AAA)
                }

                Debug = "TSK1 _TMP"
                Debug = TEMP /* \_SB_.TSK1.TEMP */
                Return (TEMP) /* \_SB_.TSK1.TEMP */
            }

            Method (_DSM, 4, NotSerialized)  // _DSM: Device-Specific Method
            {
                While (One)
                {
                    Name (_T_0, Buffer (0x01)  // _T_x: Emitted by ASL Compiler, x=0-9, A-Z
                    {
                         0x00                                             // .
