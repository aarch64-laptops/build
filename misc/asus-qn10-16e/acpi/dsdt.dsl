                                            Local0 = \_SB.ECGE._DSM (\_SB.ECGE.ECGF, Zero, \_SB.ECGE.GF12, TTGP)
                                            Return (Local1)
                                        }
                                        Else
                                        {
                                            Debug = "Invalid TZ field type for TZ36"
                                            Return (0xFFFF)
                                        }

                                        Break
                                    }
                                }
                            }
                            Else
                            {
                                Return (Buffer (One)
                                {
                                     0x00                                             // .
                                })
                            }

                            Break
                        }
                    }

                    Break
                }
            }

            Method (_TMP, 0, NotSerialized)  // _TMP: Temperature
            {
                Debug = "TZ 36 Temp Read"
                TEMP = \_SB.ECGE._DSM (\_SB.ECGE.ECGF, Zero, \_SB.ECGE.GF10, 0x06)
                If ((TEMP == 0x0FFF))
                {
                    TEMP = Zero
                }

                If (((TEMP & 0x8000) == 0x8000))
                {
                    TEMP = (TEMP ^ 0xFFFF)
                    TEMP = (TEMP + One)
                    TEMP = (TEMP * 0x0A)
                    TEMP = (0x0AAA - TEMP)
                }
                Else
                {
                    TEMP = (TEMP + 0x0AAA)
                }

                Debug = "Tz 36 _TMP"
                Debug = TEMP /* \_SB_.TZ36.TEMP */
                If ((THGF == One))
                {
                    Debug = "Get Thresholds from TZ 36"
                    THGP [Zero] = 0x02
                    THGP [One] = ((EDID << 0x04) + ETID) /* \_SB_.TZ36.ETID */
                    Local0 = \_SB.ECGE._DSM (\_SB.ECGE.ECGF, Zero, \_SB.ECGE.GF12, THGP)
                    THGF = Zero
                }

                Return (TEMP) /* \_SB_.TZ36.TEMP */
            }

            Method (_DEP, 0, NotSerialized)  // _DEP: Dependencies
            {
                Return (Package (0x03)
                {
                    \_SB.ECGE, , 
                    \_SB.PAID, , 
                    \_SB.IC10, 
                })
            }
        }

