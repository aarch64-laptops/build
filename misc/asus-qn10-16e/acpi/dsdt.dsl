                CreateByteField (BUF2, 0x02, GRTM)
                CreateByteField (BUF2, 0x03, GRTD)
                CreateByteField (BUF2, 0x04, GRTH)
                CreateByteField (BUF2, 0x05, GRMI)
                CreateByteField (BUF2, 0x06, GRTS)
                CreateByteField (BUF2, 0x07, GRTV)
                CreateWordField (BUF2, 0x08, RTMS)
                CreateWordField (BUF2, 0x0A, RTTZ)
                CreateByteField (BUF2, 0x0C, RTDL)
                CreateByteField (BUF2, 0x0D, RTP2)
                GRTS = FromBCD (RTCS)
                GRMI = FromBCD (RTMI)
                GRTH = FromBCD (RTCH)
                GRTD = FromBCD (RTCD)
                GRTM = FromBCD (RTCM)
                GRTY = (FromBCD (RTCY) + 0x07D0)
                GRTV = One
                RTMS = Zero
                RTTZ = 0x07FF
                RTDL = Zero
                RTP2 = Zero
                Return (BUF2) /* \_SB_.PT7C._GRT.BUF2 */
            }

            Method (_SRT, 1, NotSerialized)  // _SRT: Set Real Time
            {
                If ((\_SB.IC11.AVBL != One))
                {
                    Return (Zero)
                }

                CreateWordField (Arg0, Zero, RTCY)
                CreateByteField (Arg0, 0x02, RTCM)
                CreateByteField (Arg0, 0x03, RTCD)
                CreateByteField (Arg0, 0x04, RTCH)
                CreateByteField (Arg0, 0x05, RTMI)
                CreateByteField (Arg0, 0x06, RTCS)
                If ((RTCY < 0x07D0))
                {
                    Debug = "RTCY < 2000"
                    Return (0xFFFFFFFF)
                }

                If ((RTCY > 0x0833))
                {
                    Debug = "RTCY > 2099"
                    Return (0xFFFFFFFF)
                }

                RTCY -= 0x07D0
                \_SB.IC11.WRTC (Zero, ToBCD (RTCS))
                \_SB.IC11.WRTC (One, ToBCD (RTMI))
                \_SB.IC11.WRTC (0x02, ToBCD (RTCH))
                \_SB.IC11.WRTC (0x04, ToBCD (RTCD))
                \_SB.IC11.WRTC (0x05, ToBCD (RTCM))
                \_SB.IC11.WRTC (0x06, ToBCD (RTCY))
                Return (Zero)
            }
        }

