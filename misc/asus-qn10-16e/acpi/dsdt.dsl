                If ((DPBM & (One << One)))
                {
                    CHRV = (CHRV | (One << 0x05))
                    CHRV = (CHRV | (One << 0x06))
                }

                If ((DPBM & (One << 0x02)))
                {
                    CHRV = (CHRV | (One << One))
                }

                If ((DPBM & (One << 0x07)))
                {
                    CHRV = (CHRV | (One << 0x02))
                }

                If ((DPBM & (One << 0x0F)))
                {
                    CHRV = (CHRV | (One << 0x04))
                    CHRV = (CHRV | (One << One))
                }

                If ((OOBL == Zero))
                {
                    CHRV = (CHRV | (One << 0x0A))
                }

                Return (CHRV) /* \_SB_.PILC.CHRV */
            }

