            {
                Return (\_SB.TZ51.TTC2)
            }

            Name (TTSP, 0x0A)
            Method (_TSP, 0, NotSerialized)  // _TSP: Thermal Sampling Period
            {
                Return (\_SB.TZ51.TTSP)
            }

            Method (_DSM, 4, Serialized)  // _DSM: Device-Specific Method
            {
                While (One)
                {
                    Name (_T_0, Buffer (0x01)  // _T_x: Emitted by ASL Compiler, x=0-9, A-Z
                    {
                         0x00                                             // .
                    })
                    CopyObject (ToBuffer (Arg0), _T_0) /* \_SB_.TZ51._DSM._T_0 */
                    If ((_T_0 == ToUUID ("d4e1f2a3-5b6c-4d7e-8f9a-0b1c2d3e4f5a") /* Unknown UUID */))
                    {
                        While (One)
                        {
                            Name (_T_1, 0x00)  // _T_x: Emitted by ASL Compiler, x=0-9, A-Z
                            _T_1 = ToInteger (Arg2)
                            If ((_T_1 == Zero))
                            {
                                While (One)
                                {
                                    Name (_T_2, 0x00)  // _T_x: Emitted by ASL Compiler, x=0-9, A-Z
                                    _T_2 = ToInteger (Arg1)
                                    If ((_T_2 == Zero))
                                    {
                                        Local0 = 0x04
                                        Return (Local0)
                                    }
                                    Else
                                    {
                                        Return (Buffer (One)
                                        {
                                             0x00                                             // .
                                        })
                                    }

                                    Break
                                }
                            }
                            ElseIf ((_T_1 == 0x02))
                            {
                                While (One)
                                {
                                    Name (_T_3, 0x00)  // _T_x: Emitted by ASL Compiler, x=0-9, A-Z
                                    _T_3 = ToInteger (DerefOf (Arg3 [One]))
                                    If ((_T_3 == Zero))
                                    {
                                        If ((ToInteger (DerefOf (Arg3 [Zero])) == 0x02))
                                        {
                                            TPSV = ToInteger (DerefOf (Arg3 [0x02]))
                                            Notify (TZ51, 0x81) // Thermal Trip Point Change
                                        }

                                        Return (TPSV) /* \_SB_.TZ51.TPSV */
                                    }
                                    ElseIf ((_T_3 == One))
                                    {
                                        If ((ToInteger (DerefOf (Arg3 [Zero])) == 0x02))
                                        {
                                            TCRT = ToInteger (DerefOf (Arg3 [0x02]))
                                            Notify (TZ51, 0x81) // Thermal Trip Point Change
                                        }

                                        Return (TCRT) /* \_SB_.TZ51.TCRT */
                                    }
                                    ElseIf ((_T_3 == 0x02))
                                    {
                                        If ((ToInteger (DerefOf (Arg3 [Zero])) == 0x02))
                                        {
                                            TTSP = ToInteger (DerefOf (Arg3 [0x02]))
                                            Notify (TZ51, 0x81) // Thermal Trip Point Change
                                        }

                                        Return (TTSP) /* \_SB_.TZ51.TTSP */
                                    }
                                    ElseIf ((_T_3 == 0x03))
                                    {
                                        If ((ToInteger (DerefOf (Arg3 [Zero])) == 0x02))
                                        {
                                            TTC1 = ToInteger (DerefOf (Arg3 [0x02]))
                                            Notify (TZ51, 0x81) // Thermal Trip Point Change
                                        }

                                        Return (TTC1) /* \_SB_.TZ51.TTC1 */
                                    }
                                    ElseIf ((_T_3 == 0x04))
                                    {
                                        If ((ToInteger (DerefOf (Arg3 [Zero])) == 0x02))
                                        {
                                            TTC2 = ToInteger (DerefOf (Arg3 [0x02]))
                                            Notify (TZ51, 0x81) // Thermal Trip Point Change
                                        }

                                        Return (TTC2) /* \_SB_.TZ51.TTC2 */
                                    }
                                    Else
                                    {
                                        Debug = "Invalid TZ field type for TZ51"
                                        Return (0xFFFF)
                                    }

                                    Break
                                }
                            }
                            Else
                            {
                                Debug = "Invalid function Id for TZ51"
                                Return (0xFFFF)
                            }

                            Break
                        }
                    }
                    Else
                    {
                        Debug = "Invalid UUID for TZ51"
                        Return (0xFFFF)
                    }

                    Break
                }
            }

            Method (_DEP, 0, NotSerialized)  // _DEP: Dependencies
            {
                Return (Package (0x01)
                {
                    \_SB.MPA, 
                })
            }
        }

